+                    kv_rope_dst_addr + entry * Int32(rope_smem_stride * 2),
+                    data_base_i64 + _ROPE_SRC,
+                    _ROPE,
+                    full_mbar_u32,
+                )
 
     def _issue_payload():
         eo = Int32(0)
@@ -262,12 +266,13 @@ def io_issue_gather(
                         _NOPE,
                         full_mbar_u32,
                     )
-                    cp_async_bulk_g2s_mbar(
-                        kv_rope_dst_addr + entry * Int32(rope_smem_stride * 2),
-                        data_base_i64 + _ROPE_SRC,
